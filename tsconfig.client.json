{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ES2020",
        "lib": ["ES2020", "DOM"],
        "rootDir": "client",
        "outDir": "public",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "skipLibCheck": true,
        "removeComments": false
    },
    "include": ["client/**/*.ts"]
}
