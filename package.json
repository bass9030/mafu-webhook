{
    "name": "mafu-webhook",
    "version": "0.0.0",
    "private": true,
    "scripts": {
        "build": "npm run clean && tsc -p tsconfig.json && tsc -p tsconfig.client.json",
        "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
        "dev": "tsx watch bin/www.ts",
        "start": "node dist/bin/www.js",
        "test": "tsx --test tests/**/*.test.ts",
        "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.test.json --noEmit"
    },
    "dependencies": {
        "@google/genai": "^0.13.0",
        "@sentry/node": "^10.58.0",
        "cookie-parser": "~1.4.7",
        "debug": "~2.6.9",
        "deepl-node": "^1.12.0",
        "discord.js": "^14.27.0",
        "dotenv": "^16.3.1",
        "ejs": "^3.1.10",
        "express": "^4.22.2",
        "http-errors": "~1.6.3",
        "mariadb": "^3.5.3",
        "morgan": "~1.11.0"
    },
    "devDependencies": {
        "@types/cookie-parser": "^1.4.10",
        "@types/debug": "^4.1.13",
        "@types/ejs": "^3.1.5",
        "@types/express": "^5.0.6",
        "@types/http-errors": "^2.0.5",
        "@types/morgan": "^1.9.10",
        "@types/node": "^26.2.0",
        "tsx": "^4.23.11",
        "typescript": "^7.0.2"
    }
}
